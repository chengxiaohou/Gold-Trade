  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:ci": "(vitest run --reporter=dot > /tmp/test-output.txt 2>&1; tail -12 /tmp/test-output.txt; echo; if [ -s /tmp/test-output.txt ] && ! grep -q 'failed' /tmp/test-output.txt; then echo 'TESTS_PASS'; else echo 'TESTS_FAIL'; fi)"
  },
